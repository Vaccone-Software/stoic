{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "CompatPrefs",
  "description": "Preferences.",
  "x-stoic-version": {
    "key": "version",
    "current": 2,
    "oldest": 1,
    "migrations": [
      {
        "from": 1,
        "to": 2,
        "operations": [
          "rename font_size to fontSize"
        ]
      }
    ]
  },
  "properties": {
    "version": {
      "type": "integer",
      "const": 2,
      "description": "The version of this document's format."
    },
    "theme": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "description": "The theme.",
      "default": "system"
    },
    "fontSize": {
      "type": "integer",
      "minimum": 6,
      "maximum": 72,
      "x-stoic-integer-spelling": "no fraction or exponent",
      "description": "The font size.",
      "default": 13,
      "x-stoic-unit": "pt"
    },
    "recent": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0,
      "maxItems": 10,
      "description": "Recent files.",
      "default": []
    },
    "editor": {
      "type": "object",
      "title": "Editor",
      "description": "The editor.",
      "properties": {
        "tabWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "x-stoic-integer-spelling": "no fraction or exponent",
          "description": "Spaces per tab.",
          "default": 4
        },
        "wrap": {
          "type": "boolean",
          "description": "Wrap long lines.",
          "default": true
        }
      },
      "default": {
        "tabWidth": 4,
        "wrap": true
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "version"
  ]
}
